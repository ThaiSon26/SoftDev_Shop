@model SoftDev_Shop.ViewModels.DatLaiMatKhauViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-container">
    <div class="auth-top-badge">
        <span class="auth-badge-pill">
            <i class="bi bi-shield-check"></i>
        </span>
        <span class="auth-badge-text">Đặt lại mật khẩu</span>
    </div>

    <div class="auth-card">
        <h2 class="auth-title mb-2">Tạo mật khẩu mới</h2>
        <p class="text-muted text-center small mb-4">Tài khoản: <strong>@Model.Email</strong></p>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="auth-alert-danger">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-controller="Account" asp-action="DatLaiMatKhau" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="auth-field-group">
                <label asp-for="MatKhauMoi" class="auth-label">Mật khẩu mới (tối thiểu 8 ký tự)</label>
                <div class="auth-input-wrapper">
                    <input asp-for="MatKhauMoi" type="password" id="inputResetNewPassword" class="auth-input-control" placeholder="••••••••" autocomplete="new-password" />
                    <i class="bi bi-key-fill auth-icon-left"></i>
                    <button type="button" class="auth-btn-eye" data-target="inputResetNewPassword" aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block fw-semibold"></span>
            </div>

            <div class="auth-field-group">
                <label asp-for="XacNhanMatKhau" class="auth-label">Xác nhận mật khẩu mới</label>
                <div class="auth-input-wrapper">
                    <input asp-for="XacNhanMatKhau" type="password" id="inputResetConfirmPassword" class="auth-input-control" placeholder="••••••••" autocomplete="new-password" />
                    <i class="bi bi-shield-lock-fill auth-icon-left"></i>
                    <button type="button" class="auth-btn-eye" data-target="inputResetConfirmPassword" aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block fw-semibold"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn-auth-primary">
                    <span>Xác nhận đổi mật khẩu</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

