@model SoftDev_Shop.ViewModels.DangNhapViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    ViewData["Title"] = "Đăng nhập";

    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-container">
    <!-- Clean SaaS Card -->
    <div class="auth-card">
        <!-- Segmented Tab Switcher -->
        <div class="auth-tabs-wrapper">
            <button type="button" class="auth-tab-btn active" id="tabLoginBtn">Đăng nhập</button>
            <a asp-controller="Account" asp-action="DangKy" class="auth-tab-btn text-decoration-none"
                id="tabRegisterBtn">Đăng ký</a>
        </div>

        <h2 class="auth-title" id="authMainTitle">Đăng nhập tài khoản</h2>

        <!-- Alert thông báo thành công hoặc lỗi -->
        @if (TempData["SuccessMessage"] != null)

        {
            <div class="auth-alert-success">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)

        {
            <div class="auth-alert-danger">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <!-- Form Đăng nhập -->
        <form asp-controller="Account" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" method="post"
            id="formLogin">
            @Html.AntiForgeryToken()

            <!-- Email hoặc tên đăng nhập -->
            <div class="auth-field-group">
                <label asp-for="Email" class="auth-label">Email hoặc tên đăng nhập</label>
                <div class="auth-input-wrapper">
                    <input asp-for="Email" class="auth-input-control" placeholder="example@gmail.com"
                        autocomplete="username" />
                    <i class="bi bi-search auth-icon-left"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-semibold"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="auth-field-group">
                <label asp-for="MatKhau" class="auth-label">Mật khẩu</label>
                <div class="auth-input-wrapper">
                    <input asp-for="MatKhau" type="password" id="inputLoginPassword" class="auth-input-control"
                        placeholder="••••••••" autocomplete="current-password" />
                    <i class="bi bi-key-fill auth-icon-left"></i>
                    <button type="button" class="auth-btn-eye" data-target="inputLoginPassword"
                        aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block fw-semibold"></span>
            </div>

            <!-- Checkbox ghi nhớ & Quên mật khẩu -->
            <div class="auth-options-row">
                <label asp-for="GhiNhoDangNhap" class="auth-checkbox-label">
                    <input asp-for="GhiNhoDangNhap" type="checkbox" class="form-check-input mt-0"
                        style="width: 18px; height: 18px; border-radius: 5px;" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a asp-controller="Account" asp-action="QuenMatKhau" class="auth-forgot-link">Quên mật khẩu?</a>
            </div>

            <!-- Nút Đăng nhập -->
            <button type="submit" class="btn-auth-primary">
                <span>Đăng nhập</span>
            </button>

            <!-- Phân cách -->
            <div class="auth-divider">
                <span>Hoặc đăng nhập với</span>
            </div>

            <!-- Social Logins (Google & GitHub) -->
            <div class="auth-social-row">
                <button type="button" class="btn-social-saas">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path
                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                            fill="#4285F4" />
                        <path
                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                            fill="#34A853" />
                        <path
                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                            fill="#FBBC05" />
                        <path
                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                            fill="#EA4335" />
                    </svg>
                    <span>Google</span>
                </button>
                <button type="button" class="btn-social-saas">
                    <i class="bi bi-github fs-5 text-dark"></i>
                    <span>GitHub</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

