<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftDev Shop</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Style Clean SaaS White + Blue -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #eff6ff;
            --accent: #6366f1;
            --dark: #0f172a;
            --surface: #ffffff;
            --bg-page: #f8fafc;
            --border-color: #e2e8f0;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-page);
            color: #334155;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar-saas {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        .brand-logo {
            font-weight: 800;
            font-size: 1.3rem;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .brand-logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #4f46e5, #2563eb);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }
        .nav-link-custom {
            font-weight: 600;
            font-size: 0.92rem;
            color: #475569;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-link-custom:hover {
            color: var(--primary);
            background: var(--primary-light);
        }
        .footer-saas {
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }
    </style>
</head>
<body>
    <!-- HEADER NAVBAR SAAS -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-saas py-3">
            <div class="container">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-icon">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <span>SoftDev<span class="text-primary">.Shop</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" href="#featured-products">Sản phẩm nổi bật</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" href="#bento-categories">Danh mục</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" href="#partners-section">Đối tác</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Quản trị") || User.IsInRole("Nhân viên"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-bold small">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản trị
                                </a>
                            }
                            <div class="dropdown">
                                <button class="btn btn-light rounded-pill px-3 py-2 d-flex align-items-center gap-2 border fw-bold small dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-size: 0.8rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 mt-2">
                                    <li><span class="dropdown-item-text small text-muted">Quyền: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Khách hàng")</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="DangXuat" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger rounded-3 fw-semibold">
                                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="DangNhap" class="btn btn-light rounded-pill px-3 py-2 fw-bold text-dark border">
                                Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="DangKy" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #4f46e5, #2563eb); border: none;">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN BODY -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER SAAS -->
    <footer class="footer-saas py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="brand-logo mb-3">
                        <div class="brand-logo-icon">
                            <i class="bi bi-code-slash"></i>
                        </div>
                        <span>SoftDev<span class="text-primary">.Shop</span></span>
                    </div>
                    <p class="text-muted small">Nền tảng thương mại điện tử chuyên cung cấp bản quyền phần mềm, công cụ phát triển, đồ họa và tiện ích lập trình viên uy tín hàng đầu.</p>
                    <div class="d-flex gap-3 text-muted">
                        <a href="javascript:void(0)" class="text-secondary fs-5"><i class="bi bi-github"></i></a>
                        <a href="javascript:void(0)" class="text-secondary fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="javascript:void(0)" class="text-secondary fs-5"><i class="bi bi-telegram"></i></a>
                        <a href="javascript:void(0)" class="text-secondary fs-5"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Sản phẩm</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">IDE & Developer Tools</a></li>
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Hệ điều hành Windows</a></li>
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Office & Microsoft 365</a></li>
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Adobe Creative Cloud</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Chính sách & Hỗ trợ</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Chính sách bảo hành bản quyền</a></li>
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Hướng dẫn kích hoạt License Key</a></li>
                        <li><a href="javascript:void(0)" class="text-decoration-none text-muted">Quy định hoàn tiền</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Bản tin công nghệ</h6>
                    <p class="text-muted small">Nhận ưu đãi giảm giá bản quyền phần mềm và key khuyến mãi mới nhất.</p>
                    <div class="input-group">
                        <input type="email" class="form-control rounded-start-pill" placeholder="Email của bạn..." />
                        <button class="btn btn-primary rounded-end-pill px-3" type="button">Đăng ký</button>
                    </div>
                </div>
            </div>

            <div class="border-top pt-4 mt-5 d-flex flex-wrap justify-content-between align-items-center text-muted small">
                <div>&copy; 2026 SoftDev Shop. All rights reserved. Phát triển cho Developer Marketplace.</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <span class="badge bg-light text-dark border">Clean SaaS</span>
                    <span class="badge bg-light text-dark border">White + Blue</span>
                    <span class="badge bg-light text-dark border">Bento Grid UI</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
