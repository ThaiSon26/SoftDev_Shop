@{
    ViewData["Title"] = "Trang chủ - Developer Marketplace Phần Mềm";
    var categories = ViewBag.Categories as List<SoftDev_Shop.Models.Danhmuc> ?? new();
    var partners = ViewBag.Partners as List<SoftDev_Shop.Models.Doitac> ?? new();
    var featuredProducts = ViewBag.FeaturedProducts as List<SoftDev_Shop.Models.Sanpham> ?? new();
}

<!-- HERO BANNER SECTION (White + Blue + Clean SaaS) -->
<section class="py-5" style="background: radial-gradient(circle at 50% 0%, #e0e7ff 0%, #f0f4fd 50%, #f8fafc 100%);">
    <div class="container py-4 text-center">
        <!-- Pill Tagline -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white border shadow-sm mb-4">
            <span class="badge bg-primary rounded-pill">Mới</span>
            <span class="fw-bold text-dark small">Kho bản quyền phần mềm lập trình & tiện ích #1</span>
            <i class="bi bi-arrow-right text-primary"></i>
        </div>

        <h1 class="display-4 fw-bolder text-dark mb-3" style="letter-spacing: -1px;">
            Bản Quyền Phần Mềm Chính Hãng <br />
            <span style="background: linear-gradient(135deg, #2563eb, #6366f1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Dành Cho Nhà Phát Triển & Doanh Nghiệp</span>
        </h1>

        <p class="lead text-muted mx-auto mb-4" style="max-width: 680px;">
            Giao key tự động trong 30 giây. Cam kết kích hoạt online 100%, hỗ trợ kỹ thuật 24/7 và bảo hành trọn đời theo chính sách của nhà cung cấp.
        </p>

        <!-- CTA Buttons -->
        <div class="d-flex justify-content-center gap-3 mb-5">
            <a href="#featured-products" class="btn btn-primary rounded-pill px-4 py-3 fw-bold shadow" style="background: linear-gradient(135deg, #4f46e5, #2563eb); border: none;">
                <i class="bi bi-cart-check me-2"></i> Khám phá sản phẩm
            </a>
            <a asp-controller="Account" asp-action="DangKy" class="btn btn-white bg-white border rounded-pill px-4 py-3 fw-bold text-dark shadow-sm">
                <i class="bi bi-person-plus me-2"></i> Trở thành thành viên
            </a>
        </div>

        <!-- Trust Badges -->
        <div class="row g-3 justify-content-center pt-3 border-top" style="max-width: 900px; margin: 0 auto;">
            <div class="col-md-3 col-6 text-center">
                <div class="fw-bold text-dark"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Kích hoạt tức thì</div>
                <div class="small text-muted">Nhận key qua email & web</div>
            </div>
            <div class="col-md-3 col-6 text-center">
                <div class="fw-bold text-dark"><i class="bi bi-patch-check-fill text-primary me-1"></i> Chính hãng 100%</div>
                <div class="small text-muted">Nguồn từ đối tác uy tín</div>
            </div>
            <div class="col-md-3 col-6 text-center">
                <div class="fw-bold text-dark"><i class="bi bi-shield-lock-fill text-success me-1"></i> Bảo hành trọn gói</div>
                <div class="small text-muted">Đổi mới nếu lỗi key</div>
            </div>
            <div class="col-md-3 col-6 text-center">
                <div class="fw-bold text-dark"><i class="bi bi-headset text-indigo me-1" style="color: #6366f1;"></i> Hỗ trợ cài đặt</div>
                <div class="small text-muted">UltraView / AnyDesk</div>
            </div>
        </div>
    </div>
</section>

