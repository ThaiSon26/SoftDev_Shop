@model List<SoftDev_Shop.Models.Doitac>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Đối tác & Nhà phân phối";
}

<div class="row g-4">
    <!-- Cột trái: Form thêm mới Đối tác -->
    <div class="col-lg-4">
        <div class="card rounded-4 border-0 shadow-sm p-4 bg-white" style="border: 1px solid #f1f5f9 !important;">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-building-add text-primary"></i> Thêm đối tác mới
            </h5>

            <form asp-controller="Admin" asp-action="TaoDoiTac" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Tên đối tác / Nhà phân phối <span
                            class="text-danger">*</span></label>
                    <input type="text" name="tenDoiTac" class="form-control rounded-3"
                        placeholder="VD: Microsoft Authorized Partner" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Người liên hệ đại diện</label>
                    <input type="text" name="nguoiLienHe" class="form-control rounded-3"
                        placeholder="VD: Nguyễn Văn Đại Diện" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Email liên hệ</label>
                    <input type="email" name="email" class="form-control rounded-3" placeholder="partner@domain.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Số điện thoại</label>
                    <input type="tel" name="soDienThoai" class="form-control rounded-3" placeholder="0987654321" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Ghi chú đối tác</label>
                    <textarea name="ghiChu" class="form-control rounded-3" rows="3"
                        placeholder="Khu vực cung cấp key, chiết khấu..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-3 fw-bold py-2"
                    style="background: var(--primary-blue); border-color: var(--primary-blue);">
                    <i class="bi bi-plus-lg me-1"></i> Lưu thông tin đối tác
                </button>
            </form>
        </div>
    </div>

    <!-- Cột phải: Bảng danh sách Đối tác -->
    <div class="col-lg-8">
        <div class="card rounded-4 border-0 shadow-sm p-4 bg-white" style="border: 1px solid #f1f5f9 !important;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-buildings-fill text-indigo" style="color: #6366f1;"></i> Danh sách đối tác
                    (@Model.Count)
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr class="text-muted small">
                            <th>Tên đối tác</th>
                            <th>Người đại diện</th>
                            <th>Liên hệ</th>
                            <th>Ghi chú</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Chưa có đối tác nào được đăng ký.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 bg-light text-primary d-flex align-items-center justify-content-center"
                                            style="width: 36px; height: 36px;">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.TenDoiTac</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@(item.NguoiLienHe ?? "---")</span>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <div><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                        {
                                            <div><i class="bi bi-telephone me-1 text-muted"></i>@item.SoDienThoai</div>
                                        }
                                        @if (string.IsNullOrEmpty(item.Email) && string.IsNullOrEmpty(item.SoDienThoai))
                                        {
                                            <span class="text-muted">Chưa có</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted text-truncate d-inline-block"
                                        style="max-width: 160px;">@(item.GhiChu ?? "---")</span>
                                </td>
                                <td class="text-end">
                                    <form asp-controller="Admin" asp-action="XoaDoiTac" asp-route-id="@item.Id"
                                        method="post" class="d-inline"
                                        onsubmit="return confirm('Bạn có chắc chắn muốn xóa đối tác này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2"
                                            title="Xóa đối tác">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
