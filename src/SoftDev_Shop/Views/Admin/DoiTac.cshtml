@model List<SoftDev_Shop.Models.Doitac>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Đối tác";
    var totalCount = Model.Count;
    var activeCount = Model.Count(d => d.ConHoatDong == true);
    var contactCount = Model.Count(d => !string.IsNullOrEmpty(d.Email) || !string.IsNullOrEmpty(d.SoDienThoai));
}

<div class="partner-management-wrapper">
    <!-- 1. BENTO STATS CARDS: THỐNG KÊ ĐỐI TÁC -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tổng đối tác -->
        <div class="col-xl-4 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Tổng đối tác cấp key</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@totalCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 12px; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);">
                        <i class="bi bi-buildings-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Đối tác đang hợp tác -->
        <div class="col-xl-4 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Đang hoạt động / Cung cấp key</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@activeCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Đầy đủ liên hệ -->
        <div class="col-xl-4 col-md-12">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Có thông tin liên hệ trực tiếp</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@contactCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); border-radius: 12px; box-shadow: 0 4px 10px rgba(124, 58, 237, 0.3);">
                        <i class="bi bi-person-lines-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. THANH CÔNG CỤ TÌM KIẾM THỜI GIAN THỰC & NÚT THÊM -->
    <div class="card p-3 rounded-4 border-0 shadow-sm bg-white mb-4" style="border: 1px solid #f1f5f9 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchPartnerInput" class="form-control bg-light border-0 small" placeholder="Tìm theo tên đối tác, đại diện, email hoặc số điện thoại..." />
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold small" data-bs-toggle="modal" data-bs-target="#createPartnerModal" style="background: var(--primary-blue); border: none;">
                    <i class="bi bi-plus-lg me-1"></i> Thêm đối tác mới
                </button>
            </div>
        </div>
    </div>

    <!-- 3. BẢNG DỮ LIỆU ĐỐI TÁC BENTO TABLE -->
    <div class="card p-4 rounded-4 border-0 shadow-sm bg-white" style="border: 1px solid #f1f5f9 !important;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-buildings-fill text-primary"></i> Danh sách nhà phân phối & đối tác (<span id="visiblePartnerCount">@totalCount</span>)
            </h6>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover" id="partnersTable">
                <thead class="table-light">
                    <tr class="text-muted small">
                        <th>Đối tác / Nhà phân phối</th>
                        <th>Người đại diện</th>
                        <th>Thông tin liên hệ</th>
                        <th>Ghi chú cấp key</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có đối tác nào. Hãy thêm đối tác đầu tiên!</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="partner-row" data-search="@(item.TenDoiTac.ToLower() + " " + (item.NguoiLienHe ?? "").ToLower() + " " + (item.Email ?? "").ToLower() + " " + (item.SoDienThoai ?? "").ToLower())">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-3 bg-light text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-building fs-5"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.TenDoiTac</span>
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-secondary">@(item.NguoiLienHe ?? "---")</span>
                            </td>
                            <td>
                                <div class="small">
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div><i class="bi bi-envelope text-muted me-1"></i><a href="mailto:@item.Email" class="text-decoration-none text-dark">@item.Email</a></div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                    {
                                        <div><i class="bi bi-telephone text-muted me-1"></i><span class="text-muted">@item.SoDienThoai</span></div>
                                    }
                                    @if (string.IsNullOrEmpty(item.Email) && string.IsNullOrEmpty(item.SoDienThoai))
                                    {
                                        <span class="text-muted">Chưa cập nhật</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="small text-muted text-truncate d-inline-block" style="max-width: 180px;">@(item.GhiChu ?? "---")</span>
                            </td>
                            <td>
                                @if (item.ConHoatDong == true)
                                {
                                    <span class="badge rounded-pill px-2 py-1 fw-semibold" style="background: #ecfdf5; color: #059669;">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2 py-1 fw-semibold" style="background: #fef2f2; color: #b91c1c;">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Tạm ngưng
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="XoaDoiTac" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đối tác này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa đối tác">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM ĐỐI TÁC MỚI -->
<div class="modal fade" id="createPartnerModal" tabindex="-1" aria-labelledby="createPartnerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createPartnerModalLabel">
                    <i class="bi bi-building-add text-primary me-2"></i>Thêm đối tác / nhà phân phối
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="TaoDoiTac" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tên đối tác / Nhà phân phối <span class="text-danger">*</span></label>
                        <input type="text" name="tenDoiTac" class="form-control rounded-3" placeholder="VD: Microsoft Authorized Partner" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Người đại diện liên hệ</label>
                        <input type="text" name="nguoiLienHe" class="form-control rounded-3" placeholder="VD: Nguyễn Văn Đại Diện" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small text-dark">Email liên hệ</label>
                            <input type="email" name="email" class="form-control rounded-3" placeholder="partner@domain.com" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small text-dark">Số điện thoại</label>
                            <input type="tel" name="soDienThoai" class="form-control rounded-3" placeholder="0987654321" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Ghi chú đối tác</label>
                        <textarea name="ghiChu" class="form-control rounded-3" rows="3" placeholder="Kênh cấp key, hạn mức chiết khấu, thời gian bảo hành..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background: var(--primary-blue); border: none;">
                        <i class="bi bi-check-lg me-1"></i> Lưu thông tin đối tác
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lọc đối tác thời gian thực (Real-time Filter)
            const searchInput = document.getElementById("searchPartnerInput");
            const rows = document.querySelectorAll(".partner-row");
            const countDisplay = document.getElementById("visiblePartnerCount");

            function filterPartners() {
                const keyword = (searchInput?.value || "").toLowerCase().trim();
                let visibleCount = 0;

                rows.forEach(row => {
                    const searchData = row.getAttribute("data-search") || "";
                    if (searchData.includes(keyword)) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (countDisplay) {
                    countDisplay.textContent = visibleCount;
                }
            }

            if (searchInput) searchInput.addEventListener("input", filterPartners);
        });
    </script>
}
