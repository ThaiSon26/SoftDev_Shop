@model List<SoftDev_Shop.Models.Danhmuc>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Danh mục phần mềm";
    var danhMucChaList = ViewBag.DanhMucChaList as List<SoftDev_Shop.Models.Danhmuc> ?? new
    List<SoftDev_Shop.Models.Danhmuc>();
}

<div class="row g-4">
    <!-- Cột trái: Form thêm mới danh mục -->
    <div class="col-lg-4">
        <div class="card rounded-4 border-0 shadow-sm p-4 bg-white" style="border: 1px solid #f1f5f9 !important;">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-folder-plus text-primary"></i> Thêm danh mục mới
            </h5>

            <form asp-controller="Admin" asp-action="TaoDanhMuc" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Tên danh mục <span
                            class="text-danger">*</span></label>
                    <input type="text" name="tenDanhMuc" class="form-control rounded-3"
                        placeholder="VD: Đồ họa & Thiết kế" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Đường dẫn thân thiện (Slug)</label>
                    <input type="text" name="duongDan" class="form-control rounded-3"
                        placeholder="VD: do-hoa-thiet-ke (tự sinh nếu để trống)" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Danh mục cha (Cấp trên)</label>
                    <select name="danhMucChaId" class="form-select rounded-3">
                        <option value="">-- Danh mục gốc (Cấp 1) --</option>
                        @foreach (var parent in danhMucChaList)
                        {
                            <option value="@parent.Id">@parent.TenDanhMuc</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Icon biểu tượng (Bootstrap Icons)</label>
                    <input type="text" name="bieuTuong" class="form-control rounded-3"
                        placeholder="bi-palette, bi-laptop, bi-shield..." value="bi-folder" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Thứ tự hiển thị</label>
                    <input type="number" name="thuTu" class="form-control rounded-3" value="0" />
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-3 fw-bold py-2"
                    style="background: var(--primary-blue); border-color: var(--primary-blue);">
                    <i class="bi bi-plus-lg me-1"></i> Lưu danh mục
                </button>
            </form>
        </div>
    </div>

    <!-- Cột phải: Bảng danh sách danh mục -->
    <div class="col-lg-8">
        <div class="card rounded-4 border-0 shadow-sm p-4 bg-white" style="border: 1px solid #f1f5f9 !important;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap-fill text-indigo" style="color: #6366f1;"></i> Danh sách danh mục
                    (@Model.Count)
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr class="text-muted small">
                            <th>Icon</th>
                            <th>Tên danh mục</th>
                            <th>Slug</th>
                            <th>Cấp danh mục</th>
                            <th>Thứ tự</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào. Hãy tạo danh mục
                                    đầu tiên!</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="rounded-3 bg-light text-primary d-flex align-items-center justify-content-center"
                                        style="width: 38px; height: 38px;">
                                        <i
                                            class="bi @(string.IsNullOrEmpty(item.BieuTuong) ? "bi-folder" : item.BieuTuong) fs-5"></i>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@item.TenDanhMuc</span>
                                </td>
                                <td>
                                    <code class="text-muted small">@item.DuongDan</code>
                                </td>
                                <td>
                                    @if (item.DanhMucCha != null)
                                    {
                                        <span class="badge bg-secondary rounded-pill">Con của:
                                            @item.DanhMucCha.TenDanhMuc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary rounded-pill">Danh mục gốc</span>
                                    }
                                </td>
                                <td>@item.ThuTu</td>
                                <td class="text-end">
                                    <form asp-controller="Admin" asp-action="XoaDanhMuc" asp-route-id="@item.Id"
                                        method="post" class="d-inline"
                                        onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2"
                                            title="Xóa danh mục">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
