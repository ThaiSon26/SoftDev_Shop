@model List<SoftDev_Shop.Models.Danhmuc>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Danh mục";
    var danhMucChaList = ViewBag.DanhMucChaList as List<SoftDev_Shop.Models.Danhmuc> ?? new List<SoftDev_Shop.Models.Danhmuc>();
    var totalCount = Model.Count;
    var rootCount = Model.Count(d => d.DanhMucChaId == null);
    var subCount = Model.Count(d => d.DanhMucChaId != null);
    var activeCount = Model.Count(d => d.ConHoatDong == true);
}

<div class="category-management-wrapper">
    <!-- 1. BENTO STATS CARDS: THỐNG KÊ DANH MỤC -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tổng số danh mục -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Tổng danh mục</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@totalCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 12px; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);">
                        <i class="bi bi-grid-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Danh mục gốc (Cấp 1) -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Danh mục gốc (Cấp 1)</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@rootCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); border-radius: 12px; box-shadow: 0 4px 10px rgba(124, 58, 237, 0.3);">
                        <i class="bi bi-folder-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Danh mục con (Cấp 2) -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Danh mục con (Cấp 2)</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@subCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #06b6d4, #0891b2); border-radius: 12px; box-shadow: 0 4px 10px rgba(8, 145, 178, 0.3);">
                        <i class="bi bi-folder2-open fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 4: Đang hoạt động -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Đang hoạt động</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">@activeCount</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC THỜI GIAN THỰC -->
    <div class="card p-3 rounded-4 border-0 shadow-sm bg-white mb-4" style="border: 1px solid #f1f5f9 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchCategoryInput" class="form-control bg-light border-0 small" placeholder="Tìm theo tên danh mục hoặc slug url..." />
                </div>
            </div>
            <div class="col-md-3">
                <select id="filterLevelSelect" class="form-select bg-light border-0 small">
                    <option value="all">Tất cả cấp bậc</option>
                    <option value="root">Chỉ danh mục gốc (Cấp 1)</option>
                    <option value="sub">Chỉ danh mục con (Cấp 2)</option>
                </select>
            </div>
            <div class="col-md-4 text-md-end">
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold small" data-bs-toggle="modal" data-bs-target="#createCategoryModal" style="background: var(--primary-blue); border: none;">
                    <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
                </button>
            </div>
        </div>
    </div>

    <!-- 3. BẢNG DỮ LIỆU BENTO TABLE -->
    <div class="card p-4 rounded-4 border-0 shadow-sm bg-white" style="border: 1px solid #f1f5f9 !important;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-list-ul text-primary"></i> Danh sách danh mục (<span id="visibleCategoryCount">@totalCount</span>)
            </h6>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover" id="categoriesTable">
                <thead class="table-light">
                    <tr class="text-muted small">
                        <th style="width: 60px;">Icon</th>
                        <th>Tên danh mục</th>
                        <th>Đường dẫn (Slug)</th>
                        <th>Phân cấp</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr id="emptyRow">
                            <td colspan="7" class="text-center text-muted py-4">Chưa có danh mục nào. Hãy bấm "Thêm danh mục mới".</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var isRoot = item.DanhMucChaId == null;
                        <tr class="category-row" data-name="@item.TenDanhMuc.ToLower()" data-slug="@item.DuongDan.ToLower()" data-level="@(isRoot ? "root" : "sub")">
                            <td>
                                <div class="rounded-3 bg-light text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                    <i class="bi @(string.IsNullOrEmpty(item.BieuTuong) ? "bi-folder-fill" : item.BieuTuong) fs-5"></i>
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@item.TenDanhMuc</span>
                            </td>
                            <td>
                                <code class="text-primary small" style="background: #eff6ff; padding: 2px 8px; border-radius: 6px;">@item.DuongDan</code>
                            </td>
                            <td>
                                @if (!isRoot && item.DanhMucCha != null)
                                {
                                    <span class="badge rounded-pill fw-semibold" style="background: #f1f5f9; color: #475569;">
                                        <i class="bi bi-arrow-return-right me-1"></i> Con của: @item.DanhMucCha.TenDanhMuc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill fw-semibold" style="background: #e0e7ff; color: #4338ca;">
                                        Danh mục gốc
                                    </span>
                                }
                            </td>
                            <td class="fw-semibold text-secondary">@item.ThuTu</td>
                            <td>
                                @if (item.ConHoatDong == true)
                                {
                                    <span class="badge rounded-pill px-2 py-1 fw-semibold" style="background: #ecfdf5; color: #059669;">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2 py-1 fw-semibold" style="background: #fef2f2; color: #b91c1c;">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Tạm ẩn
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="XoaDanhMuc" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM DANH MỤC MỚI (Tự động sinh slug URL thân thiện) -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createCategoryModalLabel">
                    <i class="bi bi-folder-plus text-primary me-2"></i>Thêm danh mục mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="TaoDanhMuc" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" name="tenDanhMuc" id="inputTenDanhMuc" class="form-control rounded-3" placeholder="VD: Đồ Họa & Thiết Kế" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Đường dẫn thân thiện (Slug)</label>
                        <input type="text" name="duongDan" id="inputDuongDan" class="form-control rounded-3" placeholder="do-hoa-thiet-ke" />
                        <div class="form-text small">Tự động tạo từ tên danh mục nếu bạn không nhập.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Danh mục cha</label>
                        <select name="danhMucChaId" class="form-select rounded-3">
                            <option value="">-- Danh mục gốc (Cấp 1) --</option>
                            @foreach (var parent in danhMucChaList)
                            {
                                <option value="@parent.Id">@parent.TenDanhMuc</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label fw-bold small text-dark">Biểu tượng (Bootstrap Icon)</label>
                            <input type="text" name="bieuTuong" class="form-control rounded-3" placeholder="bi-folder, bi-code, bi-brush..." value="bi-folder" />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold small text-dark">Thứ tự</label>
                            <input type="number" name="thuTu" class="form-control rounded-3" value="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background: var(--primary-blue); border: none;">
                        <i class="bi bi-check-lg me-1"></i> Lưu danh mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tự sinh slug tiếng Việt thân thiện khi nhập tên danh mục
            const inputTen = document.getElementById("inputTenDanhMuc");
            const inputSlug = document.getElementById("inputDuongDan");

            function toSlug(str) {
                return str.toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/[đĐ]/g, 'd')
                    .replace(/[^a-z0-9\s-]/g, '')
                    .trim()
                    .replace(/\s+/g, '-');
            }

            if (inputTen && inputSlug) {
                inputTen.addEventListener("input", function () {
                    inputSlug.value = toSlug(this.value);
                });
            }

            // Lọc danh sách theo thời gian thực (Real-time Filter)
            const searchInput = document.getElementById("searchCategoryInput");
            const levelSelect = document.getElementById("filterLevelSelect");
            const rows = document.querySelectorAll(".category-row");
            const countDisplay = document.getElementById("visibleCategoryCount");

            function filterRows() {
                const keyword = (searchInput?.value || "").toLowerCase().trim();
                const selectedLevel = levelSelect?.value || "all";
                let visibleCount = 0;

                rows.forEach(row => {
                    const name = row.getAttribute("data-name") || "";
                    const slug = row.getAttribute("data-slug") || "";
                    const level = row.getAttribute("data-level") || "";

                    const matchText = name.includes(keyword) || slug.includes(keyword);
                    const matchLevel = (selectedLevel === "all") || (level === selectedLevel);

                    if (matchText && matchLevel) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (countDisplay) {
                    countDisplay.textContent = visibleCount;
                }
            }

            if (searchInput) searchInput.addEventListener("input", filterRows);
            if (levelSelect) levelSelect.addEventListener("change", filterRows);
        });
    </script>
}
