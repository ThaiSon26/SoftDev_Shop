@model SoftDev_Shop.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="dashboard-content-area">
    <!-- 1. HEADER CHÀO MỪNG & BỘ LỌC THỜI GIAN -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 12px; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
                <i class="bi bi-bar-chart-fill fs-5"></i>
            </div>
            <div>
                <h3 class="fw-bolder text-dark mb-0" style="letter-spacing: -0.5px;">Bảng điều khiển</h3>
                <div class="text-muted small">Chào mừng trở lại, Admin! 👋</div>
            </div>
        </div>

        <div class="dropdown">
            <button class="btn btn-white bg-white border rounded-pill px-3 py-2 small fw-bold text-dark shadow-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-calendar3 text-muted"></i>
                <span>7 ngày gần nhất</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-4 p-2">
                <li><a class="dropdown-item rounded-3 small fw-semibold" href="javascript:void(0)">Hôm nay</a></li>
                <li><a class="dropdown-item rounded-3 small fw-semibold active" href="javascript:void(0)">7 ngày gần nhất</a></li>
                <li><a class="dropdown-item rounded-3 small fw-semibold" href="javascript:void(0)">30 ngày gần nhất</a></li>
                <li><a class="dropdown-item rounded-3 small fw-semibold" href="javascript:void(0)">Năm 2026</a></li>
            </ul>
        </div>
    </div>

    <!-- 2. HÀNG 4 THẺ BENTO STATS (Chuẩn Hình số 2) -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tổng doanh thu -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100 position-relative overflow-hidden" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #eff6ff; color: #2563eb; border-radius: 12px;">
                        <i class="bi bi-bag-check-fill fs-5"></i>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small fw-semibold">Tổng doanh thu</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">
                            @Model.TongDoanhThu.ToString("N0")₫
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <span class="badge rounded-pill text-success" style="background: #ecfdf5; font-size: 0.78rem;">
                        <i class="bi bi-arrow-up-short"></i> +12.5%
                    </span>
                    <div style="height: 30px; width: 120px;">
                        <canvas id="sparklineRevenue"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Tổng đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100 position-relative overflow-hidden" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: linear-gradient(135deg, #8b5cf6, #a855f7); border-radius: 12px; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);">
                        <i class="bi bi-box-seam-fill fs-5"></i>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small fw-semibold">Tổng đơn hàng</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">
                            @Model.TongDonHang
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <span class="badge rounded-pill text-success" style="background: #ecfdf5; font-size: 0.78rem;">
                        <i class="bi bi-arrow-up-short"></i> +8.3%
                    </span>
                    <div style="height: 30px; width: 120px;">
                        <canvas id="sparklineOrders"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Tổng người dùng -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100 position-relative overflow-hidden" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small fw-semibold">Tổng người dùng</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">
                            @Model.TongNguoiDung.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <span class="badge rounded-pill text-success" style="background: #ecfdf5; font-size: 0.78rem;">
                        <i class="bi bi-arrow-up-short"></i> +15.7%
                    </span>
                    <div style="height: 30px; width: 120px;">
                        <canvas id="sparklineUsers"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 4: Đánh giá trung bình -->
        <div class="col-xl-3 col-md-6">
            <div class="card p-3 rounded-4 border-0 shadow-sm bg-white h-100 position-relative overflow-hidden" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px; box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-star-fill fs-5"></i>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small fw-semibold">Đánh giá trung bình</span>
                        <div class="fs-4 fw-bolder text-dark mt-1" style="font-weight: 800;">
                            4.8/5
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <span class="badge rounded-pill text-warning" style="background: #fffbeb; font-size: 0.78rem;">
                        <i class="bi bi-star-fill me-1"></i> +0.1
                    </span>
                    <div style="height: 30px; width: 120px;">
                        <canvas id="sparklineRatings"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. HÀNG 2: BIỂU ĐỒ DOANH THU & ĐƠN HÀNG GẦN ĐÂY -->
    <div class="row g-4 mb-4">
        <!-- Cột trái: Biểu đồ đường kép (Doanh thu & Đơn hàng) -->
        <div class="col-xl-6">
            <div class="card p-4 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-line-fill text-primary fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Biểu đồ doanh thu</h6>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2 small">
                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #2563eb;"></span>
                            <span class="text-muted">Doanh thu</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 small">
                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #8b5cf6;"></span>
                            <span class="text-muted">Đơn hàng</span>
                        </div>
                        <select class="form-select form-select-sm rounded-pill border-0 bg-light small fw-bold text-dark" style="width: 100px;">
                            <option>7 ngày</option>
                            <option>30 ngày</option>
                        </select>
                    </div>
                </div>

                <div style="height: 280px; width: 100%;">
                    <canvas id="mainSalesChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng đơn hàng gần đây (5 dòng chuẩn hình số 2) -->
        <div class="col-xl-6">
            <div class="card p-4 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Đơn hàng gần đây</h6>
                    </div>
                    <a href="javascript:void(0)" class="text-decoration-none fw-bold small text-primary d-flex align-items-center gap-1">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover small">
                        <thead>
                            <tr class="text-muted">
                                <th>#</th>
                                <th>Khách hàng</th>
                                <th>Sản phẩm</th>
                                <th>Số tiền</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.DonHangGanDay)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@order.MaDonHang</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                @(order.TenKhachHang.Substring(0, 1))
                                            </div>
                                            <span class="fw-semibold text-dark">@order.TenKhachHang</span>
                                        </div>
                                    </td>
                                    <td class="text-dark">@order.TenSanPham</td>
                                    <td class="fw-bold text-dark">@order.SoTien.ToString("N0")₫</td>
                                    <td>
                                        @if (order.TrangThai == "Đã thanh toán")
                                        {
                                            <span class="badge rounded-pill fw-semibold px-2 py-1" style="background: #ecfdf5; color: #059669;">Đã thanh toán</span>
                                        }
                                        else if (order.TrangThai == "Đang xử lý")
                                        {
                                            <span class="badge rounded-pill fw-semibold px-2 py-1" style="background: #eff6ff; color: #2563eb;">Đang xử lý</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill fw-semibold px-2 py-1" style="background: #fffbeb; color: #d97706;">Chờ xử lý</span>
                                        }
                                    </td>
                                    <td class="text-muted">@order.ThoiGian</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. HÀNG 3: SẢN PHẨM BÁN CHẠY + THỐNG KÊ DANH MỤC + THÔNG TIN HỆ THỐNG -->
    <div class="row g-4">
        <!-- Cột 1: Sản phẩm bán chạy -->
        <div class="col-xl-4 col-md-6">
            <div class="card p-4 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-trophy-fill text-warning fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Sản phẩm bán chạy</h6>
                    </div>
                    <a href="javascript:void(0)" class="text-decoration-none fw-bold small text-primary">Xem tất cả &rarr;</a>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var prod in Model.SanPhamBanChay)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background: #f8fafc;">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; background: @(prod.Hang == 1 ? "#f59e0b" : prod.Hang == 2 ? "#94a3b8" : "#d97706"); color: white;">
                                    @prod.Hang
                                </span>
                                <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 38px; height: 38px; background: @prod.BgColor;">
                                    <i class="bi @prod.Icon fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">@prod.TenSanPham</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@prod.MoTaNgan</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark small">@prod.Gia.ToString("N0")₫</div>
                                <div class="text-success small fw-semibold">@prod.PhanTramTang</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột 2: Thống kê theo danh mục (Donut Chart) -->
        <div class="col-xl-4 col-md-6">
            <div class="card p-4 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-pie-chart-fill text-indigo fs-5" style="color: #6366f1;"></i>
                    <h6 class="fw-bold text-dark mb-0">Thống kê theo danh mục</h6>
                </div>

                <div class="row align-items-center my-auto">
                    <div class="col-6 position-relative text-center">
                        <canvas id="categoryDonutChart" style="max-height: 140px;"></canvas>
                        <div class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none;">
                            <div class="fw-bolder fs-5 text-dark">35%</div>
                            <div class="text-muted" style="font-size: 0.65rem;">Món chính</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex flex-column gap-2 small">
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-circle-fill text-primary me-1" style="font-size: 0.6rem;"></i> Món chính</span>
                                <span class="fw-bold">35%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-circle-fill text-warning me-1" style="font-size: 0.6rem;"></i> Món phụ</span>
                                <span class="fw-bold">28%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.6rem;"></i> Món nước</span>
                                <span class="fw-bold">22%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-circle-fill text-purple me-1" style="color: #8b5cf6; font-size: 0.6rem;"></i> Khác</span>
                                <span class="fw-bold">15%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột 3: Thông tin hệ thống -->
        <div class="col-xl-4 col-md-12">
            <div class="card p-4 rounded-4 border-0 shadow-sm bg-white h-100" style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-hdd-network-fill text-primary fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0">Thông tin hệ thống</h6>
                    </div>
                    <span class="badge rounded-pill fw-semibold px-2 py-1" style="background: #ecfdf5; color: #059669;">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Hoạt động tốt
                    </span>
                </div>

                <div class="d-flex flex-column gap-3 small">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted"><i class="bi bi-server me-2"></i>Máy chủ</span>
                        <span class="fw-bold text-dark">localhost</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted"><i class="bi bi-database me-2"></i>Cơ sở dữ liệu</span>
                        <span class="fw-bold text-dark">MySQL 8.0</span>
                    </div>
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="text-muted"><i class="bi bi-hdd me-2"></i>Dung lượng</span>
                            <span class="fw-bold text-dark">2.1 GB / 10 GB</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 21%;"></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted"><i class="bi bi-clock-history me-2"></i>Thời gian hoạt động</span>
                        <span class="fw-bold text-dark">12 ngày, 4 giờ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Sparklines cho 4 card thống kê
            function createSparkline(canvasId, color, data) {
                const ctx = document.getElementById(canvasId);
                if (!ctx) return;
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['', '', '', '', '', ''],
                        datasets: [{
                            data: data,
                            borderColor: color,
                            borderWidth: 2,
                            pointRadius: 0,
                            tension: 0.4,
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { enabled: false } },
                        scales: { x: { display: false }, y: { display: false } }
                    }
                });
            }

            createSparkline('sparklineRevenue', '#2563eb', [12, 19, 14, 25, 22, 30]);
            createSparkline('sparklineOrders', '#8b5cf6', [5, 12, 8, 15, 12, 18]);
            createSparkline('sparklineUsers', '#10b981', [20, 24, 22, 28, 25, 32]);
            createSparkline('sparklineRatings', '#f59e0b', [4.5, 4.6, 4.7, 4.8, 4.8, 4.9]);

            // 2. Biểu đồ đường kép Doanh thu & Đơn hàng (Hình số 2)
            const mainCtx = document.getElementById('mainSalesChart');
            if (mainCtx) {
                new Chart(mainCtx, {
                    type: 'line',
                    data: {
                        labels: ['Th 2', 'Th 3', 'Th 4', 'Th 5', 'Th 6', 'Th 7', 'CN'],
                        datasets: [
                            {
                                label: 'Doanh thu',
                                data: [6, 9, 11, 13, 17, 13, 15],
                                borderColor: '#2563eb',
                                backgroundColor: '#2563eb',
                                borderWidth: 3,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                tension: 0.3
                            },
                            {
                                label: 'Đơn hàng',
                                data: [3, 4, 7, 6, 12, 9, 8],
                                borderColor: '#8b5cf6',
                                backgroundColor: '#8b5cf6',
                                borderWidth: 2,
                                borderDash: [5, 5],
                                pointRadius: 3,
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: '#94a3b8' } },
                            y: {
                                grid: { color: '#f1f5f9' },
                                ticks: {
                                    color: '#94a3b8',
                                    callback: function(val) { return val + 'M'; }
                                }
                            }
                        }
                    }
                });
            }

            // 3. Donut Chart Thống kê Danh mục (Hình số 2)
            const donutCtx = document.getElementById('categoryDonutChart');
            if (donutCtx) {
                new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Món chính', 'Món phụ', 'Món nước', 'Khác'],
                        datasets: [{
                            data: [35, 28, 22, 15],
                            backgroundColor: ['#3b82f6', '#eab308', '#10b981', '#8b5cf6'],
                            borderWidth: 0,
                            cutout: '72%'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}
