@model SoftDev_Shop.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển quản trị";
}

<div class="dashboard-wrapper">
    <!-- 1. HÀNG 3 THẺ CHỈ SỐ BENTO STATS (như hình mẫu) -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tổng doanh thu (màu tím/xanh nổi bật) -->
        <div class="col-md-4">
            <div class="card stat-card p-4 rounded-4 border-0 shadow-sm bg-white h-100 position-relative overflow-hidden"
                style="background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 100%); border: 1px solid #ede9fe !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold" style="color: #6366f1; font-size: 0.95rem;">Tổng doanh thu</span>
                    <span class="badge rounded-pill" style="background: #e0e7ff; color: #4338ca;">+18.4%</span>
                </div>
                <div class="display-6 fw-bolder text-dark mb-0" style="letter-spacing: -0.5px; font-weight: 800;">
                    @(Model.TongDoanhThu > 1000000 ? (Model.TongDoanhThu / 1000000).ToString("N1") + "M₫" :
                        Model.TongDoanhThu.ToString("N0") + "₫")
                </div>
                <div class="small text-muted mt-2">So với tháng trước</div>
            </div>
        </div>

        <!-- Thẻ 2: Đơn hàng -->
        <div class="col-md-4">
            <div class="card stat-card p-4 rounded-4 border-0 shadow-sm bg-white h-100"
                style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold text-muted" style="font-size: 0.95rem;">Đơn hàng</span>
                    <i class="bi bi-bag-check fs-5 text-primary"></i>
                </div>
                <div class="display-6 fw-bolder text-dark mb-0" style="letter-spacing: -0.5px; font-weight: 800;">
                    @Model.TongDonHang
                </div>
                <div class="small text-success mt-2 fw-semibold">
                    <i class="bi bi-arrow-up-short"></i> Đang tăng trưởng
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Người dùng -->
        <div class="col-md-4">
            <div class="card stat-card p-4 rounded-4 border-0 shadow-sm bg-white h-100"
                style="border: 1px solid #f1f5f9 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold text-muted" style="font-size: 0.95rem;">Người dùng</span>
                    <i class="bi bi-people fs-5 text-indigo" style="color: #6366f1;"></i>
                </div>
                <div class="display-6 fw-bolder text-dark mb-0" style="letter-spacing: -0.5px; font-weight: 800;">
                    @(Model.TongNguoiDung >= 1000 ? (Model.TongNguoiDung / 1000.0).ToString("N1") + "K" :
                        Model.TongNguoiDung.ToString())
                </div>
                <div class="small text-muted mt-2">Khách hàng & Đối tác</div>
            </div>
        </div>
    </div>

    <!-- 2. BIỂU ĐỒ DOANH THU THEO THÁNG (Chart Card bám sát ảnh mẫu) -->
    <div class="card rounded-4 border-0 shadow-sm bg-white p-4 mb-4" style="border: 1px solid #f1f5f9 !important;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 text-dark">Doanh thu theo tháng</h5>
            <div class="d-flex gap-2">
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">Năm 2026</span>
            </div>
        </div>

        <div style="height: 220px; width: 100%;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <!-- 3. ĐƠN HÀNG MỚI NHẤT (Danh sách đơn hàng bám sát ảnh mẫu) -->
    <div class="card rounded-4 border-0 shadow-sm bg-white p-4" style="border: 1px solid #f1f5f9 !important;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 text-dark">Đơn hàng mới nhất</h5>
            <a href="javascript:void(0)"
                class="text-decoration-none fw-bold small text-primary d-flex align-items-center gap-1">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="recent-orders-list d-flex flex-column gap-3">
            <!-- Đơn hàng mẫu 1 (Bám sát thiết kế có icon hộp phần mềm màu tím, mã đơn, giá tiền và badge xanh lá) -->
            <div class="order-item p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
                style="background: #f8fafc; border: 1px solid #f1f5f9;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                        style="width: 48px; height: 48px; background: linear-gradient(135deg, #6366f1, #4338ca); box-shadow: 0 4px 12px rgba(67, 56, 202, 0.25);">
                        <i class="bi bi-window-stack fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">#5001301031</div>
                        <div class="text-muted small">Khách hàng: Nguyễn Văn An</div>
                    </div>
                </div>

                <div class="text-end">
                    <div class="fw-bold text-dark" style="font-size: 1rem;">₫100.000</div>
                    <div class="text-muted small text-decoration-line-through">₫120.000</div>
                </div>

                <div>
                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                        style="background: #dcfce7; color: #15803d; font-size: 0.85rem;">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                    </span>
                </div>
            </div>

            <!-- Đơn hàng mẫu 2 -->
            <div class="order-item p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
                style="background: #f8fafc; border: 1px solid #f1f5f9;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                        style="width: 48px; height: 48px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">#5001301032</div>
                        <div class="text-muted small">Khách hàng: Trần Thị Mai</div>
                    </div>
                </div>

                <div class="text-end">
                    <div class="fw-bold text-dark" style="font-size: 1rem;">₫450.000</div>
                    <div class="text-muted small text-decoration-line-through">₫500.000</div>
                </div>

                <div>
                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                        style="background: #dcfce7; color: #15803d; font-size: 0.85rem;">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                    </span>
                </div>
            </div>

            <!-- Đơn hàng mẫu 3 -->
            <div class="order-item p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
                style="background: #f8fafc; border: 1px solid #f1f5f9;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                        style="width: 48px; height: 48px; background: linear-gradient(135deg, #10b981, #047857); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);">
                        <i class="bi bi-code-square fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">#5001301033</div>
                        <div class="text-muted small">Khách hàng: Lê Quốc Hưng</div>
                    </div>
                </div>

                <div class="text-end">
                    <div class="fw-bold text-dark" style="font-size: 1rem;">₫1.250.000</div>
                    <div class="text-muted small">Bản quyền 1 năm</div>
                </div>

                <div>
                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                        style="background: #fef9c3; color: #854d0e; font-size: 0.85rem;">
                        <i class="bi bi-clock-history me-1"></i> Chờ xử lý
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js để vẽ biểu đồ đường doanh thu giống ảnh mẫu -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('revenueChart');
            if (!ctx) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang.Select(x => x.Thang)));
            const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang.Select(x => x.DoanhThu)));

            const gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 200);
            gradient.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
            gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: dataValues,
                        borderColor: '#6366f1',
                        borderWidth: 3,
                        pointBackgroundColor: '#6366f1',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.4,
                        fill: true,
                        backgroundColor: gradient
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.parsed.y + ' Triệu VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 11 } }
                        },
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                color: '#94a3b8',
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                callback: function (value) { return value + 'M'; }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
